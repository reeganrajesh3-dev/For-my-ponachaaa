<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For My Ponn ❤️🧿</title>
    <style>
        body {
            background-color: #FDF5E6;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: 'Serif', Georgia, serif;
            overflow-x: hidden;
            text-align: center;
        }
        .container { padding: 20px; max-width: 400px; }
        .card {
            background: #FFB6C1;
            padding: 30px;
            border-radius: 25px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }
        .gallery {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-top: 20px;
        }
        .photo-frame {
            background: white;
            padding: 10px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .photo-frame img {
            width: 100%;
            border-radius: 5px;
            display: block;
        }
        .caption {
            font-size: 12px;
            margin-top: 8px;
            color: #555;
            font-style: italic;
        }
        video {
            width: 100%;
            border-radius: 15px;
            margin-top: 20px;
            display: none;
        }
        button {
            background: #FF4D4D;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 50px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 20px;
        }
        #heart-scanner {
            width: 100px;
            height: 100px;
            background: #ff4d4d;
            border-radius: 50%;
            margin: 20px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 40px;
            animation: pulse 1.5s infinite;
            cursor: pointer;
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
        .hidden { display: none; }
    </style>
</head>
<body>

    <div id="intro" class="container">
        <div class="card">
            <h1>Will you be mine? ❤️</h1>
            <button onclick="nextStep('intro', 'gallery-section')">YES!</button>
        </div>
    </div>

    <div id="gallery-section" class="container hidden">
        <div class="card">
            <h2>Look at this cutie 😭</h2>
            <div class="gallery">
                <div class="photo-frame"><img src="photo1.jpg"><div class="caption">Sweet Hello</div></div>
                <div class="photo-frame"><img src="photo2.jpg"><div class="caption">True Smile</div></div>
                <div class="photo-frame"><img src="photo3.jpg"><div class="caption">Perfect Day</div></div>
                <div class="photo-frame"><img src="photo4.jpg"><div class="caption">Only Us</div></div>
                <div class="photo-frame"><img src="photo5.jpg"><div class="caption">My Home</div></div>
                <div class="photo-frame"><img src="photo6.jpg"><div class="caption">Forever Us</div></div>
            </div>
            <button onclick="nextStep('gallery-section', 'scanner-section')">NEXT →</button>
        </div>
    </div>

    <div id="scanner-section" class="container hidden">
        <div class="card">
            <h3>Hold your heart to scan...</h3>
            <div id="heart-scanner" onmousedown="startScan()" onmouseup="stopScan()" ontouchstart="startScan()" ontouchend="stopScan()">❤️</div>
            <p id="status">HOLD TO SCAN</p>
        </div>
    </div>

    <div id="final-surprise" class="container hidden">
        <div class="card">
            <h2>I Love You! ❤️🧿</h2>
            <video id="surprise-video" controls>
                <source src="final_video.mp4" type="video/mp4">
            </video>
            <p>You are my favorite person in the whole world.</p>
        </div>
    </div>

    <script>
        function nextStep(current, next) {
            document.getElementById(current).classList.add('hidden');
            document.getElementById(next).classList.remove('hidden');
        }

        let scanTimer;
        function startScan() {
            document.getElementById('status').innerText = "SCANNING...";
            scanTimer = setTimeout(() => {
                nextStep('scanner-section', 'final-surprise');
                document.getElementById('surprise-video').style.display = 'block';
            }, 3000);
        }

        function stopScan() {
            clearTimeout(scanTimer);
            if (document.getElementById('status')) {
                document.getElementById('status').innerText = "HOLD TO SCAN";
            }
        }
    </script>
</body>
</html>
